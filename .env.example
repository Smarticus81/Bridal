# --- Supabase database (required) ---
# Dashboard -> Project Settings -> Database -> Connect -> URI (Session pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase storage (required for photo/gallery uploads) ---
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=glimpse
SUPABASE_PUBLIC_BUCKET=glimpse-public

# --- App ---
PORT=5000
# Public site URL for email links, share URLs, and Stripe redirects (no trailing slash).
APP_BASE_URL=http://localhost:5000
# On Railway you can omit this if RAILWAY_PUBLIC_DOMAIN is set, or set explicitly:
# APP_BASE_URL=https://your-service.up.railway.app
# EMAIL_FROM=glimpse <notifications@yourdomain.com>
SESSION_SECRET=generate-a-long-random-string
UPLOAD_TOKEN_SECRET=generate-a-second-long-random-string
# Optional cleanup tuning. Defaults are production-safe; raise only for high-volume deployments.
# STALE_PROCESSING_SESSION_MINUTES=90
# UPLOAD_INTENT_CLEANUP_BATCH_SIZE=100
# OWNER_AUTH_CLEANUP_BATCH_SIZE=500

# --- Clerk (auth + organizations) ---
# Optional at boot: without Clerk keys the app still deploys, but
# owner/organization routes return 503 and the web app shows a setup notice
# until Clerk is configured. Couple galleries and share links work regardless.
# To enable Clerk, set CLERK_SECRET_KEY AND a publishable key together —
# the session middleware needs both.
# Dashboard -> API keys. Members sign in with Clerk profiles; one Clerk
# Organization per account owns billing and all venues.
# NOTE: production keys (pk_live_/sk_live_) only work when the site is served
# from the Clerk instance's domain or a subdomain of it. On any other host —
# e.g. the *.up.railway.app URL — the browser gets a 400 from Clerk and
# sign-in cannot load; use pk_test_/sk_test_ development keys there instead.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Same publishable key, exposed to the Vite build for the web app.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Dashboard -> Webhooks -> endpoint https://your-host/api/webhooks/clerk
# Subscribe to: organization.created and organization.updated (name sync).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Stripe billing (organization-level) ---
# The organization owns the subscription and the shared credit pool.
# Webhook endpoint: https://your-host/api/billing/webhook
# Events: checkout.session.completed, invoice.paid, customer.subscription.deleted
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_CREDIT_PACK_10=price_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=glimpse <noreply@yourdomain.com>

# --- AI gallery pipeline ---
# Gemini powers both generation and quality review.
# Production default: Gemini 3 Pro Image first for best likeness and venue fidelity,
# with native Gemini image fallbacks only when the primary model is unavailable.
GOOGLE_AI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image
# Optional override for the full ordered chain.
# GEMINI_IMAGE_MODELS=gemini-3-pro-image,gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=2K
# Optional beta transport. Keep unset for stable production generateContent.
# GEMINI_USE_INTERACTIONS_API=false
# Optional Gemini API base override. Must be v1beta: image generation config
# (responseModalities/imageConfig) is not available on the v1 surface.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GENERATED_IMAGE_MIN_EDGE_PX=1024
GENERATED_IMAGE_MIN_CONTRAST=8
GENERATED_IMAGE_MIN_SHARPNESS=6
GALLERY_FRAME_ATTEMPTS=4
# Required for the branded MP4 motion reel.
# Leave unset when ffmpeg is on PATH or placed in artifacts/api-server/bin.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Multimodal quality gate. Set GALLERY_QUALITY_GATE=off only for emergency fallback.
# Production startup refuses lowered likeness/venue thresholds and non-Pro QA models.
GEMINI_QUALITY_MODEL=gemini-2.5-pro
GALLERY_QUALITY_GATE=on
GALLERY_MIN_LIKENESS_SCORE=0.82
GALLERY_MIN_PARTNER_LIKENESS_SCORE=0.78
GALLERY_MIN_VENUE_SCORE=0.80
GALLERY_MIN_COMPOSITION_SCORE=0.74
# Acceptance floors: when no retry hits the strict targets above, the best
# attempt still ships if it clears these floors plus all hard integrity checks
# (two distinct real partners, faces visible, no extra people/text). The venue
# owner reviews every gallery before sending, so they stay the final judge.
GALLERY_FLOOR_LIKENESS_SCORE=0.70
GALLERY_FLOOR_PARTNER_LIKENESS_SCORE=0.66
GALLERY_FLOOR_VENUE_SCORE=0.68
GALLERY_FLOOR_COMPOSITION_SCORE=0.60

# Optional: Google Cloud Storage instead of Supabase (advanced)
# PUBLIC_OBJECT_SEARCH_PATHS=/your-gcs-bucket/public
# PRIVATE_OBJECT_DIR=/your-gcs-bucket/.private
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
