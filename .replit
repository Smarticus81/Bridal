modules = ["web", "nodejs-24", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5000"
NODE_ENV = "development"
APP_BASE_URL = "http://localhost:5000"
GALLERY_QUALITY_GATE = "off"
GEMINI_IMAGE_SIZE = "2K"
GALLERY_FRAME_ATTEMPTS = "4"
GENERATED_IMAGE_MIN_EDGE_PX = "1024"
GENERATED_IMAGE_MIN_CONTRAST = "8"
GENERATED_IMAGE_MIN_SHARPNESS = "6"
GALLERY_MIN_LIKENESS_SCORE = "0.82"
GALLERY_MIN_PARTNER_LIKENESS_SCORE = "0.78"
GALLERY_MIN_VENUE_SCORE = "0.80"
GALLERY_MIN_COMPOSITION_SCORE = "0.74"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-dev.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["bash", "-c", "pnpm --filter @workspace/wedding-app run build && pnpm --filter @workspace/api-server run build"]
